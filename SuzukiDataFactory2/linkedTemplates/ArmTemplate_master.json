{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "SuzukiDataFactory2"
		},
		"githttpsuzukisink_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'githttpsuzukisink'"
		},
		"sinkadls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'sinkadls'"
		},
		"githttp_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"githttpsuzukisink_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://suzukistorageaccount2.dfs.core.windows.net/"
		},
		"githttpsuzukisource_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"sinkadls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://hondastorage123.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "SuzukiDataFactory2_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"githttpsuzukisink_accountKey": {
						"value": "[parameters('githttpsuzukisink_accountKey')]"
					},
					"sinkadls_accountKey": {
						"value": "[parameters('sinkadls_accountKey')]"
					},
					"githttp_properties_typeProperties_url": {
						"value": "[parameters('githttp_properties_typeProperties_url')]"
					},
					"githttpsuzukisink_properties_typeProperties_url": {
						"value": "[parameters('githttpsuzukisink_properties_typeProperties_url')]"
					},
					"githttpsuzukisource_properties_typeProperties_url": {
						"value": "[parameters('githttpsuzukisource_properties_typeProperties_url')]"
					},
					"sinkadls_properties_typeProperties_url": {
						"value": "[parameters('sinkadls_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}